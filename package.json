{
  "name": "enigmoss",
  "version": "1.0.0",
  "description": "Official TypeScript client of the Enigmoss Project API v4: payments, wallets, payouts, refunds, transfers, webhooks.",
  "license": "MIT",
  "homepage": "https://github.com/enigmoss/nodejs-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enigmoss/nodejs-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/enigmoss/nodejs-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "enigmoss",
    "payments",
    "payouts",
    "crypto",
    "api",
    "sdk"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
